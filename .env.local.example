# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Public site URL. Used to build OAuth redirect URIs and post-login
# redirects, so it must match the domain the app is served from.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NVIDIA API (for Jim + Michael agents)
NV_API_KEY=your-nvidia-api-key
NV_BASE_URL=https://integrate.api.nvidia.com/v1
